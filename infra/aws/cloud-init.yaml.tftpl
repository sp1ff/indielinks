#cloud-config
# Per-node bootstrap, rendered by templatefile() in instances.tofu with
# node_id (the durable Raft node ID) and region. Runs once at first boot.
# No application package and no secrets appear here: the package arrives by
# scp/ssh at deploy time and secrets resolve from SSM via the instance role.

package_update: true
package_upgrade: false

# acl: the indielinks-aws postinst calls setfacl but only declares a debconf
# dependency, so acl must come from here. ca-certificates/curl: fetching the
# CloudWatch Agent over TLS. The rest are operator conveniences.
packages:
  - acl
  - ca-certificates
  - curl
  - dnsutils
  - file
  - htop
  - less
  - lsof
  - net-tools
  - netcat-openbsd
  - procps
  - sudo
  - vim

# Nodes are IPv6-only, so every AWS-speaking process on the host must use
# dual-stack endpoints. No single mechanism covers both cases, so set
# AWS_USE_DUALSTACK_ENDPOINT twice:
#  - /etc/environment: applied by pam_env to PAM sessions, including
#    non-interactive SSH (how aws-bootstrap runs indielinks-schemas) and
#    interactive operator shells;
#  - systemd DefaultEnvironment: applied to every service on the host
#    (indielinks-aws.service and the CloudWatch Agent alike). PID 1 reads
#    system.conf.d only at startup and on daemon-reexec (daemon-reload is
#    NOT enough), so runcmd reexecs below; the indielinks-aws package is
#    installed over SSH long after first boot, so it always starts with the
#    variable in place.
# cloud-init's own runcmd is neither a PAM session nor a systemd service, so
# the agent-ctl invocation below keeps its inline prefix.
write_files:
  - path: /etc/environment
    append: true
    content: |
      AWS_USE_DUALSTACK_ENDPOINT=true
  - path: /etc/systemd/system.conf.d/10-dualstack-endpoints.conf
    content: |
      [Manager]
      DefaultEnvironment=AWS_USE_DUALSTACK_ENDPOINT=true

# The service user/group and log directory are created in runcmd rather than
# via the users-groups module: a users-groups failure aborts creation of the
# default "admin" user too, locking operators out (observed with cloud-init
# 22.4.2 on the Debian 12 AMI). runcmd failures cannot do that. The guards
# mirror the indielinks-aws postinst, which skips anything already present.
runcmd:
  - getent group indielinks >/dev/null || addgroup --quiet --system indielinks
  - getent passwd indielinks >/dev/null || adduser --quiet --system --ingroup indielinks --no-create-home --disabled-password indielinks
  # Log directory ahead of the package so the CloudWatch Agent can tail it.
  - [mkdir, -p, /var/log/indielinks]
  - [chown, indielinks:indielinks, /var/log/indielinks]
  - [chmod, "0755", /var/log/indielinks]
  # Pre-seed the debconf database so the indielinks-aws postinst can render
  # this-node without prompting (the package is installed later, over SSH).
  - echo "indielinks-aws indielinks/node-id string ${node_id}" | debconf-set-selections
  # CloudWatch Agent from the region's S3 bucket over the dual-stack endpoint
  # (nodes are IPv6-only).
  - curl -fsSL --retry 5 -o /tmp/amazon-cloudwatch-agent.deb "https://amazoncloudwatch-agent-${region}.s3.dualstack.${region}.amazonaws.com/debian/amd64/latest/amazon-cloudwatch-agent.deb"
  - dpkg -i /tmp/amazon-cloudwatch-agent.deb
  - rm -f /tmp/amazon-cloudwatch-agent.deb
  # Make PID 1 re-read system.conf.d so the DefaultEnvironment written above
  # applies to the agent started below and to indielinks-aws.service when it
  # is installed later over SSH.
  - systemctl daemon-reexec
  # Pull the agent configuration from the SSM parameter created by
  # cloudwatch.tofu; aws_instance.nodes depends_on that resource so it always
  # exists by first boot. -m ec2 detects region and credentials via IMDS.
  - AWS_USE_DUALSTACK_ENDPOINT=true /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c ssm:/indielinks/prod/cloudwatch-agent-config
