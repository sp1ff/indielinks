#!/usr/bin/env bash
VERSION=0.0.1

set -euo pipefail

help=
nargs=0
prev_option=
verbose=
version=
for option
do
    # If the previous option required an argument, assign it now.
    if test -n "$prev_option"; then
        eval $prev_option=\$option
        prev_option=
        nargs=$(($nargs+1))
        continue
    fi

    # Parse out the argument option in $option, if present.
    case $option in
        *=?*) optarg=$(expr "X$option" : '[^=]*=\(.*\)') ;;
        *=)   optarg= ;;
        *)    optarg=yes ;;
    esac

    # Options are handled here:
    case $option in
        -h | --he | --hel | --help)
	        nargs=$(($nargs+1));
            help=yes;;
        -v | --verb | --verbose)
	        nargs=$(($nargs+1));
            verbose=yes;;
        -V | --vers | --version)
	        nargs=$(($nargs+1));
            version=yes;;
        -*)
            cat >&2 <<EOF
Unrecognized option '$option'.
Try 'build-debian-packages --help' for more information.
EOF
            exit 2;;
	    *)
	        # $@ now contains the arguments, $# the number of arguments
	        shift $nargs;
	        break;;
    esac

done

if test -n "${help}"; then
    cat <<EOF
'build-debian-packages' -- build all indielinks Debian binary packages in a Debian container

Usage:

    build-debian-packages [OPTION...] ARGUMENT...

Options:

    -h, --help      Print this message & exit
    -V, --version   Print this script's version & exit
    -v, --verbose   Produce prolix output

Discussion:

The Debian binary packages need to be built in a Debian container. This is
because the Debian repositories, famously slow to update, likely contain a copy
of glibc several versions behind that on your development machine (unless, I
suppose, you're developing on Debian). Since we're building binary packages,
attempting to install the resulting packages on a Debian host would produce
glibc errors. See 'debian/README.org' for more details.
EOF
    exit 0
fi

if test -n "${version}"; then
    cat <<EOF
build-debian-packages $VERSION
EOF
    exit 0
fi

if test -n "${verbose}"; then
    set -x
fi


here=$(dirname "$(realpath "$0")")
cd ${here}/..
cd ${here}
./debian/build-debian-image
docker run --mount type=bind,src=..,dst=/indielinks \
        -u packager:users                           \
        indielinks-debian:latest                     \
       /indielinks/admin/debian/build-packages
./validate-aws-frontend ${here}/../indielinks-fe/dist-aws
