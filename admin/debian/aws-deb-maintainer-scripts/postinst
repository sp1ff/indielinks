#!/usr/bin/bash
set -e

cfg='/etc/indielinks.toml'
cfg_template='/usr/share/indielinks/templates/indielinks.toml'
group='indielinks'
local_state='/var/run/indielinks'
log='/var/log/indielinks'
user='indielinks'

case "$1" in
    configure)
        if ! getent group "$group" >/dev/null; then
            addgroup --quiet --system "$group"
        fi

        if ! getent passwd "$user" >/dev/null; then
            adduser --quiet --system \
                    --ingroup "$group" \
                    --no-create-home \
                    --disabled-password \
                    "$user"
        fi

        if [ ! -d "$local_state" ]; then
            mkdir -p "$local_state"
            chown -R "$user:$group" "$local_state"
            chmod 0755 "$local_state"
        fi

        if [ ! -d "$log" ]; then
            mkdir -p "$log"
            chown -R "$user:$group" "$log"
            chmod 0755 "$log"
        fi

        if [ -f "$cfg" ]; then
            # render from the extant file
            nodeid=$(grep -E '^this-node = [0-9]+' $cfg 2>/dev/null || true)
            content=$(cat "$cfg_template"; printf x)
            content=${content%x}
            rendered=${content//this-node = '"PLACEHOLDER"'/"$nodeid"}

            tmp=$(mktemp "$cfg.XXXXXX")
            trap 'rm -f "$tmp"' EXIT
            printf '%s' "$rendered" > "$tmp"
            chmod 644 "$tmp"
            ucf --debconf-ok --three-way "$tmp" "$cfg"
            rm -rf "$tmp"
            setfacl -m u:indielinks:r "$cfg"
            trap - EXIT
        else
            # render a new file
            tmp=$(mktemp -d) # temp directory
            cp $cfg_template $tmp
            trap 'rm -f "$tmp"' EXIT
            # Debconf: retrieve the Raft node ID and replace the placeholder
            . /usr/share/debconf/confmodule
            db_get indielinks/node-id
            NODE_ID="$RET"

            if [ -n "$NODE_ID" ]; then
                sed -i "s/this-node = \"PLACEHOLDER\"/this-node = ${NODE_ID}/" "$tmp/indielinks.toml"
            fi

            cp -v "$tmp/indielinks.toml" "$cfg"
            chmod 644 "$cfg"
            chown indielinks:indielinks "$cfg"
            rm -rf "$tmp"
            trap - EXIT
        fi

        db_stop

        # Mask the general service to prevent port conflicts on upgrade
        if [ -d /run/systemd/system ]; then
            systemctl mask indielinks.service >/dev/null || true
        fi
    ;;
esac

#DEBHELPER#

exit 0
